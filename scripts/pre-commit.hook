#!/bin/sh
# pre-commit hook: проверка секретов через trufflehog3

echo "Выполняется поиск секретов (trufflehog3)..."

trufflehog3 --no-history --no-entropy . 2>&1
if [ $? -ne 0 ]; then
  echo ""
  echo "⚠ Найдены подозрительные секреты! Коммит отклонён."
  echo "   Проверьте файлы above в вашем репозитории."
  echo "   Если это ложное срабатывание, используйте: git commit --no-verify"
  exit 1
fi

echo "✓ Секретов не найдено. Коммит разрешён."
exit 0