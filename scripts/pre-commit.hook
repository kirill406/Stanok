#!/bin/sh
# pre-commit hook: run tests + secrets scan
# Works with Git for Windows (MSYS2 bash)

# 1. Run pytest
echo "Running tests (pytest)..."
python -m pytest tests/ -q
if [ $? -ne 0 ]; then
  echo ""
  echo "Tests FAILED! Commit rejected."
  echo "Fix the failing tests or use: git commit --no-verify"
  exit 1
fi

echo "All tests passed."

# 2. Scan for secrets via trufflehog3 (optional - skip if not installed)
echo "Scanning for secrets (trufflehog3)..."
python -m trufflehog3 --no-history --no-entropy . 2>/dev/null
if [ $? -ne 0 ]; then
  python -m trufflehog3 --version 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "trufflehog3 not installed, skipping secrets scan."
  else
    echo ""
    echo "Suspicious secrets detected! Commit rejected."
    echo "Check the files above in your repository."
    echo "If this is a false positive, use: git commit --no-verify"
    exit 1
  fi
fi

echo "No secrets found. Commit allowed."
exit 0
