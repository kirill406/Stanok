{
  "version": 2,
  "templates": {
    "договор 1.docx": {
      "fields": {
        "организация": {
          "type": "constant",
          "value": ""
        },
        "должность_поставщика": {
          "type": "constant",
          "value": ""
        },
        "адрес_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "адрес"
        },
        "doc_number": {
          "type": "counter",
          "start": 1
        }
      },
      "batch": {
        "sources": {
          "инфа.xlsx": {
            "file": "инфа.xlsx",
            "mode": "constant",
            "continue_from_last": false
          },
          "клиенты.xlsx": {
            "file": "клиенты.xlsx",
            "mode": "sequential",
            "continue_from_last": true
          }
        },
        "filename_template": "{{ фио_клиента }}_{{ doc_number }}.docx"
      },
      "resume": {
        "last_counter_value": 0,
        "sources": {},
        "continue_from_last": false
      }
    }
  }
}
