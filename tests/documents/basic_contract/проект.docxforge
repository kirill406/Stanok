{
  "version": 1,
  "templates": {
    "договор_поставки.docx": {
      "fields": {
        "организация": {
          "type": "constant",
          "value": "ООО Ромашка"
        },
        "должность_поставщика": {
          "type": "table",
          "file": "сотрудники.xlsx",
          "column": "должность"
        },
        "фио_поставщика": {
          "type": "table",
          "file": "сотрудники.xlsx",
          "column": "фио",
          "linked_to": "должность_поставщика"
        },
        "название_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "название"
        },
        "должность_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "должность",
          "linked_to": "название_клиента"
        },
        "фио_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "фио",
          "linked_to": "название_клиента"
        },
        "ИНН_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "ИНН",
          "linked_to": "название_клиента"
        },
        "адрес_клиента": {
          "type": "table",
          "file": "клиенты.xlsx",
          "column": "адрес",
          "linked_to": "название_клиента"
        },
        "doc_number": {
          "type": "counter",
          "start": 1,
          "step": 1,
          "format": "0001"
        }
      },
      "advanced": {
        "cycles": [
          {
            "table": "спецификация.xlsx",
            "columns": {
              "наименование": "наименование",
              "количество": "количество",
              "цена": "цена"
            }
          }
        ],
        "aggregations": {
          "итого": {
            "function": "sum",
            "table": "спецификация.xlsx",
            "column": "цена"
          },
          "с_ндс": {
            "function": "sum_multiply",
            "table": "спецификация.xlsx",
            "column": "цена",
            "multiplier": 1.2
          }
        }
      }
    }
  }
}