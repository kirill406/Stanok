{
  "version": "0.0.0",
  "templates": {
    "Договор": {
      "file": "Шаблоны/Договор.docx",
      "fields": {
        "ФИО": {"source": "table", "value": "ФИО", "counter_name": "emp"},
        "Возраст": {"source": "table", "value": "Возраст", "counter_name": "emp"},
        "Номер": {"source": "counter", "value": "doc_num"},
        "Дата": {"source": "today", "value": null},
        "Город": {"source": "constant", "value": "Москва"}
      },
      "limit": 10
    },
    "Акт": {
      "file": "Шаблоны/Акт.docx",
      "fields": {
        "ФИО": {"source": "table", "value": "ФИО", "counter_name": "emp"},
        "Номер": {"source": "counter", "value": "act_num"}
      }
    }
  },
  "default_template": "Договор",
  "data_sources": [
    {"file": "Данные/Сотрудники.xlsx", "mode": "sequential"},
    {"file": "Данные/Проекты.xlsx", "mode": "circular"}
  ],
  "counters": {
    "doc_num": {"pos": 42, "format": "plain"},
    "act_num": {"pos": 7, "format": "month"},
    "emp": {"pos": 0, "format": "1", "table": "Данные/Сотрудники.xlsx"},
    "proj": {"pos": 5, "format": "1", "table": "Данные/Проекты.xlsx"}
  },
  "filename_template": "{template} №{Номер}"
}
